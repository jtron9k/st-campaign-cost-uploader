# ServiceTitan credentials. Copy to .env and fill in. Never commit .env.
# Comma-separated list of tenant slugs this install can write to. Every slug
# listed here needs its own complete block below, or startup fails naming the
# first variable it could not find. Drop the slugs you do not use.
ST_TENANTS=acme_east,acme_west,northwind,globex

# One block per tenant. The slug is uppercased and embedded in the var name.
ST_TENANT_ACME_EAST_ID=
ST_TENANT_ACME_EAST_CLIENT_ID=
ST_TENANT_ACME_EAST_CLIENT_SECRET=
ST_TENANT_ACME_EAST_APP_KEY=

ST_TENANT_ACME_WEST_ID=
ST_TENANT_ACME_WEST_CLIENT_ID=
ST_TENANT_ACME_WEST_CLIENT_SECRET=
ST_TENANT_ACME_WEST_APP_KEY=

ST_TENANT_NORTHWIND_ID=
ST_TENANT_NORTHWIND_CLIENT_ID=
ST_TENANT_NORTHWIND_CLIENT_SECRET=
ST_TENANT_NORTHWIND_APP_KEY=

ST_TENANT_GLOBEX_ID=
ST_TENANT_GLOBEX_CLIENT_ID=
ST_TENANT_GLOBEX_CLIENT_SECRET=
ST_TENANT_GLOBEX_APP_KEY=
